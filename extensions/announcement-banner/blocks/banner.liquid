{% if shop.metafields.my_app.announcement != blank %}
  <div class="announcement-banner">
    <p>{{ shop.metafields.my_app.announcement }}</p>
  </div>

  <style>
    .announcement-banner {
      background-color: {{ block.settings.background_color }};
      color: {{ block.settings.text_color }};
      text-align: center;
      padding: 12px 24px;
      font-size: 16px;
      position: fixed;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 99999;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
      border-radius: 50px;
      max-width: 90%;
      width: max-content;
    }
    .announcement-banner p {
      margin: 0;
      font-weight: 500;
    }
  </style>
{% endif %}

{% schema %}
{
  "name": "Announcement Banner",
  "target": "body",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    }
  ]
}
{% endschema %}
